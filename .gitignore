.DS_Store
.venv/
.idea/
.vscode/
.ipynb_checkpoints/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw and derived data stay outside version control.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated analysis products are reproducible from notebooks/config.
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
